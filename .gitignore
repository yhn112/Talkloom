# Directory rules are anchored to the repository root with a leading slash. An unanchored
# `build/` also matches any nested directory of that name — it silently swallowed
# .agents/skills/build/, and the missing skill only surfaced when a commit refused it.

# Generated by XcodeGen from project.yml — not a source of truth
/Transcriber.xcodeproj/
xcuserdata/

# SwiftPM
/.build/
/.swiftpm/
Packages/*/.build/
Packages/*/.swiftpm/

# Build products
/build/
/build-codeql/
/build-coverage/
/build-release/
/coverage/
/DerivedData/
*.dmg

# Local environment for the Python tooling
/.venv/

# ASR models — downloaded separately, gigabytes in size
/Models/
*.bin
*.gguf
*.mlmodelc
*.mlpackage

# Recordings and results — private data, never in the repository
/Recordings/
*.wav
*.caf
*.m4a
*.mp3
/Transcripts/

# Evaluation fixtures and reports
/Tests/fixtures/audio/
/Tests/reports/*
!/Tests/reports/baseline.md

# Secrets
.env
*.apikey

# macOS
.DS_Store

# Sanitizer runs keep their own derived data; instrumented objects must not be
# reused by an ordinary build (scripts/sanitize.sh).
/build-san/
