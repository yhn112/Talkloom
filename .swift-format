{
  "version": 1,
  "lineLength": 100,
  "indentation": { "spaces": 4 },
  "tabWidth": 4,
  "respectsExistingLineBreaks": true,
  "lineBreakBeforeEachArgument": false,
  "maximumBlankLines": 1,
  "rules": {
    "NoAccessLevelOnExtensionDeclaration": false,
    "AlwaysUseLowerCamelCase": false,
    "OrderedImports": true
  }
}
